---
import Base from "@/layouts/Base.astro";
import ClipCard from "@/components/ClipCard.astro";
import { getClipDescription, getClipSocialImage, getClipTitle, type ClipEntry } from "@/lib/clips";
import { getClipEntries } from "@/lib/content";
import { withBase } from "@/lib/paths.mjs";

export async function getStaticPaths() {
  return (await getClipEntries()).map((clip) => ({
    params: { slug: clip.slug },
    props: { clip },
  }));
}
const { clip } = Astro.props as { clip: ClipEntry };
---
<Base title={getClipTitle(clip)} description={getClipDescription(clip)} image={getClipSocialImage(clip)} pathname={`/clips/${clip.slug}/`}>
  <h1 class="sr-only">{getClipTitle(clip)}</h1>
  <a class="back-link" href={withBase("/")}>All clips</a>
  <div class="permalink"><ClipCard entry={clip} /></div>
</Base>
