---
import { render } from "astro:content";
import type { ClipEntry } from "@/lib/clips";

const { entry } = Astro.props as { entry: ClipEntry };
const hasBody = Boolean(entry.body?.trim());
const rendered = hasBody ? await render(entry) : undefined;
const Content = rendered?.Content;
---
{Content && <div class="markdown-body"><Content /></div>}
