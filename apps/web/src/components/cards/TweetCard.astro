---
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import { formatDate, type ClipEntry } from "@/lib/clips";
import { withBase } from "@/lib/paths.mjs";
const { entry } = Astro.props as { entry: ClipEntry };
if (entry.data.kind !== "tweet") throw new Error("TweetCard received a non-tweet entry.");
const example = entry.collection === "examples";
---

<CardShell entry={entry}>
  <div class="post-author">
    {entry.data.author.avatar && <img src={withBase(entry.data.author.avatar)} alt="" width="36" height="36" loading="lazy" />}
    <div>
      <strong>{entry.data.author.name}</strong>
      <span>@{entry.data.author.handle}</span>
    </div>
  </div>
  <blockquote class="post-text">{entry.data.text}</blockquote>
  {entry.data.media?.length && (
    <div class="post-media">
      {entry.data.media.map((media) => <img src={withBase(media.src)} alt={media.alt ?? ""} loading="lazy" />)}
    </div>
  )}
  {!example && <a class="post-source" href={entry.data.url} target="_blank" rel="noreferrer">View post on X, {formatDate(entry.data.postedAt)}</a>}
  <EntryBody entry={entry} slot="commentary" />
</CardShell>
