---
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import type { ClipEntry } from "@/lib/clips";
import { withBase } from "@/lib/paths.mjs";

const { entry } = Astro.props as { entry: ClipEntry };
if (entry.data.kind !== "image") throw new Error("ImageCard received a non-image entry.");
---

<CardShell entry={entry}>
  <figure class="image-clip">
    <img src={withBase(entry.data.src)} alt={entry.data.alt ?? ""} width={entry.data.width} height={entry.data.height} loading="lazy" />
    {entry.data.alt && (
      <figcaption>
        {entry.data.sourceUrl && entry.collection !== "examples"
          ? <a href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.alt}</a>
          : entry.data.alt}
      </figcaption>
    )}
  </figure>
  <EntryBody entry={entry} slot="commentary" />
</CardShell>
