---
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import { getClipDescription, getClipSourceLabel, getClipTitle, type ClipEntry } from "@/lib/clips";
import { withBase } from "@/lib/paths.mjs";

const { entry } = Astro.props as { entry: ClipEntry };
if (entry.data.kind !== "link") throw new Error("LinkCard received a non-link entry.");
const title = getClipTitle(entry);
const description = getClipDescription(entry);
const example = entry.collection === "examples";
---

<CardShell entry={entry}>
  <div class:list={["link-preview", { "has-thumbnail": entry.data.ogImage }]}>
    <div>
      <p class="clip-source">{getClipSourceLabel(entry)}</p>
      <h2 class="clip-title">
        {example ? title : <a href={entry.data.url} target="_blank" rel="noreferrer">{title}</a>}
      </h2>
      {description && description !== entry.data.url && description !== entry.data.siteName && <p class="clip-description">{description}</p>}
    </div>
    {entry.data.ogImage && <img class="link-thumbnail" src={withBase(entry.data.ogImage)} alt="" width="120" height="90" loading="lazy" />}
  </div>
  <EntryBody entry={entry} slot="commentary" />
</CardShell>
