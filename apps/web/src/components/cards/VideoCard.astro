---
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import type { ClipEntry } from "@/lib/clips";
import { withBase } from "@/lib/paths.mjs";
const { entry } = Astro.props as { entry: ClipEntry };
if (entry.data.kind !== "video") throw new Error("VideoCard received a non-video entry.");
const provider = { youtube: "YouTube", vimeo: "Vimeo", other: "Video" }[entry.data.provider];
const example = entry.collection === "examples";
---

<CardShell entry={entry}>
  <div class:list={["link-preview", { "has-thumbnail": entry.data.thumbnail }]}>
    <div>
      <p class="clip-source">{entry.data.channel ?? provider}</p>
      <h2 class="clip-title">{example ? entry.data.title : <a href={entry.data.url} target="_blank" rel="noreferrer">{entry.data.title}</a>}</h2>
      {!example && <a class="post-source" href={entry.data.url} target="_blank" rel="noreferrer">Watch on {provider}</a>}
    </div>
    {entry.data.thumbnail && <img class="link-thumbnail" src={withBase(entry.data.thumbnail)} alt="" width="120" height="90" loading="lazy" />}
  </div>
  <EntryBody entry={entry} slot="commentary" />
</CardShell>
