---
import CardShell from "@/components/cards/CardShell.astro";
import EntryBody from "@/components/EntryBody.astro";
import type { ClipEntry } from "@/lib/clips";
const { entry } = Astro.props as { entry: ClipEntry };
if (entry.data.kind !== "note") throw new Error("NoteCard received a non-note entry.");
---
<CardShell entry={entry}><EntryBody entry={entry} /></CardShell>
