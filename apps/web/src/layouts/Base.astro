---
import "@/styles/global.css";
import Paperclip from "@/components/Paperclip.astro";
import { absoluteUrl, withBase } from "@/lib/paths.mjs";
import site from "../../../../site.config.mjs";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pathname?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image,
  pathname = "/",
  noindex = false,
} = Astro.props;
const canonical = absoluteUrl(pathname);
const socialImage = image ? absoluteUrl(image) : absoluteUrl("/social.svg");
const commitSha = import.meta.env.PUBLIC_COMMIT_SHA ?? "dev";
const repoUrl = site.repo ? `https://github.com/${site.repo}` : undefined;
const pageTitle = title === site.title ? site.title : `${title} · ${site.title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const saved = localStorage.getItem("cliplink-theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FFFDF6" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={withBase("/fonts/gabarito-latin-variable.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={withBase("/fonts/fonts.css")} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={absoluteUrl("/rss.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header page-shell">
      <a class="site-identity" href={withBase("/")} aria-label={`${site.owner}, all clips`}>
        <Paperclip />
        <span>{site.owner}</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href={withBase("/rss.xml")}>RSS</a>
        <button class="theme-toggle" type="button" aria-label="Switch to dark mode" hidden>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z" />
          </svg>
        </button>
      </nav>
    </header>
    <main id="main" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer page-shell">
      <a class="footer-credit" href="https://github.com/iamrajjoshi/cliplink">Made with Cliplink</a>
      {repoUrl && <a class="commit-link" href={`${repoUrl}/commit/${commitSha}`} aria-label={`Source, commit ${commitSha}`}>{commitSha}</a>}
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const preference = matchMedia("(prefers-color-scheme: dark)");
      function updateTheme() {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : preference.matches;
        toggle?.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} mode`);
        if (toggle) toggle.dataset.themeState = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#261F24" : "#FFFDF6");
      }
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener("click", () => {
          const dark = root.dataset.theme ? root.dataset.theme === "dark" : preference.matches;
          root.dataset.theme = dark ? "light" : "dark";
          try { localStorage.setItem("cliplink-theme", root.dataset.theme); } catch {}
          updateTheme();
        });
      }
      preference.addEventListener("change", () => {
        let saved: string | null = null;
        try { saved = localStorage.getItem("cliplink-theme"); } catch {}
        if (saved !== "dark" && saved !== "light") {
          root.dataset.theme = preference.matches ? "dark" : "light";
          updateTheme();
        }
      });
      updateTheme();
    </script>
  </body>
</html>
